# RunBait Backend Environment Variables
# Copy this to .env and fill in your values

# GitHub personal access token (classic, read-only scopes: repo, read:user)
# Get one at: https://github.com/settings/tokens
# This is OPTIONAL for public repos (but recommended to avoid rate limits)
GITHUB_TOKEN=your_github_token_here

# Google AI / Gemini API key
# Get one at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase — from your Supabase project > Connect > Python
SUPABASE_URL=
SUPABASE_KEY=

# GitHub OAuth App credentials
# Create one at: GitHub → Settings → Developer settings → OAuth Apps → New OAuth App
# Set callback URL to: http://localhost:8000/api/auth/github/callback
GITHUB_CLIENT_ID=your_github_oauth_app_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_app_client_secret

# JWT — generate a strong random secret (e.g. openssl rand -hex 32)
JWT_SECRET=your_random_jwt_secret_min_32_chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# URLs (no trailing slash)
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000